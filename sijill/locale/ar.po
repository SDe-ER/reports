msgid "KSA VAT Return"
msgstr "إقرار ضريبة القيمة المضافة"

msgid "KSA VAT Return Detail"
msgstr "تفاصيل إقرار ضريبة القيمة المضافة"

msgid "KSA VAT Settings"
msgstr "إعدادات ضريبة القيمة المضافة السعودية"

msgid "KSA VAT Account"
msgstr "حساب ضريبة القيمة المضافة السعودية"

msgid "KSA VAT Accounts"
msgstr "حسابات ضريبة القيمة المضافة"

msgid "VAT Account Type"
msgstr "نوع حساب الضريبة"

msgid "Output VAT"
msgstr "ضريبة المخرجات"

msgid "Input VAT"
msgstr "ضريبة المدخلات"

msgid "VAT Settlement"
msgstr "تسوية الضريبة"

msgid ""
"Output VAT: VAT charged on sales. Input VAT: VAT paid on purchases. VAT "
"Settlement: the account that receives the VAT balance when a return is "
"closed or paid, and any clearing account between VAT accounts. Entries that "
"only move amounts between these accounts are not reported."
msgstr ""
"ضريبة المخرجات: الضريبة المحصلة على المبيعات. ضريبة المدخلات: الضريبة "
"المدفوعة على المشتريات. تسوية الضريبة: الحساب الذي يُرحَّل إليه رصيد الضريبة"
" عند إقفال الإقرار أو سداده، وأي حساب وسيط بين حسابات الضريبة. القيود التي "
"تنقل المبالغ بين هذه الحسابات فقط لا تظهر في الإقرار."

msgid "Add at least one account of type {0}"
msgstr "أضف حساباً واحداً على الأقل من نوع {0}"

msgid "Adjustment"
msgstr "التعديلات"

msgid "Company {0} is not in Saudi Arabia."
msgstr "الشركة {0} ليست في المملكة العربية السعودية."

msgid ""
"The company {0} is not in Saudi Arabia. The KSA VAT Return is only available"
" for companies in Saudi Arabia."
msgstr ""
"الشركة {0} ليست في المملكة العربية السعودية. إقرار ضريبة القيمة المضافة متاح"
" لشركات المملكة العربية السعودية فقط."

